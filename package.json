{
  "name": "warden",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike:opencode": "node --experimental-strip-types spike/opencode.ts",
    "spike:codex": "node --experimental-strip-types spike/codex.ts",
    "build": "vite build",
    "build:desktop": "npm run build && esbuild src/electron/main.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-electron/main.mjs",
    "rebuild:electron": "electron-rebuild -f -w node-pty",
    "desktop": "npm run build:desktop && electron .",
    "package:mac": "npm run build:desktop && npm run rebuild:electron && electron-packager . Warden --platform=darwin --arch=arm64 --out=release --overwrite --icon=assets/Warden.icns --asar.unpackDir=node_modules/node-pty",
    "dev": "npm run desktop",
    "start": "npm run desktop",
    "server": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.33",
    "@radix-ui/colors": "^3.0.0",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "vite": "^8.3.1"
  }
}
